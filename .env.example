# GeoTrace local server environment template.
#
# The server reads variables from the process environment; it does NOT load this
# file automatically. Export them in your shell before starting the server, e.g.:
#
#   set -a; . ./.env; set +a
#   pnpm run dev:server
#
# The Vite dev server proxies /auth, /api and /health to http://127.0.0.1:3000,
# so the frontend needs no environment variables during development.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# --- PostgreSQL -------------------------------------------------------------
# Local Unix-socket connection; use a TCP URL for remote databases.
DATABASE_URL=postgresql:///geotrace?host=/var/run/postgresql

# --- Active Directory (production identity) ---------------------------------
# Required in production. LDAP_URL and LDAP_BASE_DN must be provided together.
# Production rejects ldap:// unless LDAP_STARTTLS=true; prefer ldaps://.
# LDAP_URL=ldaps://dc.example.invalid:636
# LDAP_STARTTLS=false
# LDAP_BASE_DN=DC=example,DC=invalid
# Optional service account used to bind before searching:
# LDAP_BIND_DN=CN=svc-geotrace,OU=Service,DC=example,DC=invalid
# LDAP_BIND_PASSWORD=replace-me
# LDAP_USER_SEARCH_FILTER=(|(sAMAccountName={{username}})(userPrincipalName={{username}})(mail={{username}}))

# --- Session cookie ---------------------------------------------------------
SESSION_COOKIE_NAME=geotrace_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_DOMAIN=example.invalid

# --- Local admin fallback (development and test only) -----------------------
# Never enable in production: the server rejects LOCAL_ADMIN_ENABLED=true when
# NODE_ENV=production. Generate the hash with `pnpm run local-admin`.
# Single-quote the hash when exporting it manually so the shell does not expand
# its `$` separators.
LOCAL_ADMIN_ENABLED=false
# LOCAL_ADMIN_USERNAME=local-admin
# LOCAL_ADMIN_PASSWORD_HASH='scrypt$16384$8$1$<32 hex chars>$<128 hex chars>'
